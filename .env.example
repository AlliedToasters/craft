# Copy this file to .env and fill in values you actually need.
# Anything left blank uses the default shown in the comment.
#
# .env is gitignored — never commit it.

# ─── LLM providers ─────────────────────────────────────────────────────────

# Anthropic API key. Only required if you'll run rollouts with a `claude-*`
# model (e.g. claude-haiku-4-5). Leave blank if you only use local Ollama.
ANTHROPIC_API_KEY=

# Local Ollama endpoint (OpenAI-compatible /v1). Default assumes Ollama is
# running on the same box as the agent.
# Override to point at a remote GPU box, e.g.:
#   OLLAMA_BASE_URL=http://my-gpu-host.local:11434/v1
OLLAMA_BASE_URL=http://localhost:11434/v1


# ─── Minecraft substrate ──────────────────────────────────────────────────

# The mc_api.py HTTP wrapper running alongside the MC server (see server/
# README). Default assumes server + agent on the same box.
MC_SERVER_CMD_BASE=http://127.0.0.1:4747

# In-game username your client is logged in as. Used as default target for
# console commands (TP, effect, gamemode, etc.).
MC_PLAYER_NAME=Player

# The homunculus Fabric mod running inside your MC client. The agent talks
# to this for inventory, pos, automining, etc.
# https://github.com/AlliedToasters/homunculus
HOMUNCULUS_HOST=127.0.0.1
HOMUNCULUS_PORT=25566


# ─── PrismLauncher (optional, only for the launch_agent.sh fleet) ─────────

# If `prismlauncher` is on PATH (system package install) you can leave this
# blank. Set it to the AppImage path if that's how you have it installed:
#   PRISMLAUNCHER_BIN=$HOME/Downloads/PrismLauncher-Linux-x86_64.AppImage
PRISMLAUNCHER_BIN=

# IP/hostname of the MC server the agent fleet should auto-join.
CRAFT_MC_HOST=127.0.0.1


# ─── World wipe over SSH (optional, for cycle.sh) ─────────────────────────

# cycle.sh → wipe_server.sh sshs into the MC host and runs a remote wipe
# script (regenerates the world from the same seed). Leave blank to skip;
# you'll get a clear error if cycle.sh is invoked without these set.
#
#   CRAFT_WIPE_SSH=user@mc-host
#   CRAFT_WIPE_SCRIPT=/absolute/path/on/remote/mc_wipe.sh
CRAFT_WIPE_SSH=
CRAFT_WIPE_SCRIPT=
